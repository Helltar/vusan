# the part of the code shape a formatter can hold; the rest is in AGENTS.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# a wrapped list keeps its trailing comma; this stops the IDE from stripping one.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# one blank line separates, two are noise; and none is left hanging above a closing brace.
ij_kotlin_keep_blank_lines_in_declarations = 1
ij_kotlin_keep_blank_lines_in_code = 1
ij_kotlin_keep_blank_lines_before_right_brace = 0

[*.{yml,yaml}]
indent_size = 2

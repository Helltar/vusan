<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %highlight(%logger{36}) %cyan([%thread]) %magenta(%M)-[%line] --> %msg%n</pattern>
        </encoder>
    </appender>

    <!-- A failing LLM call (e.g. a transient 429/503 Gemini quota dump) is re-logged at ERROR with the
         full provider error body at every layer it bubbles through: node, subgraph, then the agent itself.
         AgentRunner logs one concise line at the boundary, so silence Koog's duplicate dumps from the agent
         package. Tool-level diagnostics live under ai.koog.agents.core.environment and are left intact. -->
    <logger name="ai.koog.agents.core.agent" level="OFF"/>

    <!-- The full request sent to the model on every LLM call: system prompt, recap, history, the
         current turn with its context blocks, tool calls and their results. It is verbose and it
         prints raw user content, so it is off unless PROMPT_DUMP_LEVEL=DEBUG is set. -->
    <logger name="PromptDump" level="${PROMPT_DUMP_LEVEL:-OFF}"/>

    <!-- A level logback does not recognize (a typo, an empty value) silently becomes DEBUG here, so
         a stray LOG_LEVEL floods rather than quiets. -->
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>

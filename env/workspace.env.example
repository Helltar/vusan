# the workspace controller's environment. this process holds the Docker socket, so it never receives
# the bot's file: no API keys, no Telegram token, nothing an escape could reuse. Keep it that way.
# Every value is optional — the service has a working default for each. See docs/configuration.md.

# WORKSPACE_TIMEOUT_SECONDS=120
# read by the bot too, from its own file: keep both sides equal
# WORKSPACE_MAX_TIMEOUT_SECONDS=600
# WORKSPACE_MAX_CONCURRENT=2
# WORKSPACE_MAX_ACTIVE=2
# WORKSPACE_IDLE_MINUTES=60
# a workspace nobody has touched for this many days is deleted whole: files, home disk and records
# WORKSPACE_RETAIN_DAYS=14
# WORKSPACE_IDLE_CPU_SECONDS=600

# WORKSPACE_MEMORY_MB=1024
# WORKSPACE_CPUS=1
# WORKSPACE_PIDS_LIMIT=256

# WORKSPACE_DISK_WARN_MB=2048
# WORKSPACE_MAX_HOME_MB=4096
# WORKSPACE_MAX_FILE_MB=4096
# WORKSPACE_MIN_FREE_MB=1024
# WORKSPACE_MIN_FREE_INODES=10000
# the loop device is selected automatically; `none` removes a cap entirely
# WORKSPACE_WRITE_BPS=50mb
# WORKSPACE_READ_BPS=100mb

# WORKSPACE_NETWORK=open
# bandwidth is capped in both directions without any extra setup
# WORKSPACE_NETWORK_MBIT=50
# extra public router/infrastructure IPs; the host interface addresses are blocked automatically
# WORKSPACE_BLOCKED_CIDRS=

# WORKSPACE_NAMESPACE=vusan

# only when the bot runs on another host: the same secret it uses, and its own file has it too
# WORKSPACE_TOKEN=

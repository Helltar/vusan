# vusan's settings: copy to `.env` and fill in the required ones. every setting is in
# docs/configuration.md.
#
# a commented line shows what vusan does without it: the default, or nothing when the feature is off
# until it is set. secrets are left empty, and an empty value counts as missing.
#
# compose reads this file too, for the two settings at the bottom. the sandbox server has an `.env`
# of its own and never sees this one.

# --- required ------------------------------------------------------------------------------------
# docs/configuration.md#minimum-setup

# from @BotFather
TELEGRAM_BOT_TOKEN=

# your telegram user id: the person the bot belongs to, answered everywhere
OWNER_ID=

# openai, anthropic, openrouter, google, deepseek, xai, codex or openai-compatible
LLM_PROVIDER=openai
# named as the provider lists it: google/gemini-3.8-flash on openrouter, gemini-3.8-flash on google
LLM_MODEL=gpt-6.1-sol
LLM_API_KEY=

# --- who the bot answers -------------------------------------------------------------------------
# docs/configuration.md#who-vusan-answers

# user and group ids besides the owner, comma-separated; the owner alone when empty
# ALLOWED_IDS=
# ids the bot ignores, whatever else allows them
# BANNED_IDS=

# --- llm -----------------------------------------------------------------------------------------
# docs/configuration.md#llm-provider

# none, low, medium, high, xhigh or max; the model's own when unset
# LLM_REASONING_EFFORT=
# seconds one model call may hang before the turn fails
# LLM_REQUEST_TIMEOUT_SECONDS=300
# required where nothing states the model's window
# LLM_CONTEXT_WINDOW_TOKENS=

# for openai-compatible only: the address without /v1, and completions or responses
# LLM_BASE_URL=
# LLM_COMPATIBLE_API=completions

# model calls one turn may make before it has to wrap up
# AGENT_MAX_MODEL_CALLS=100
# people served at the same time
# MAX_CONCURRENT_TURNS=8

# --- chatgpt subscription (LLM_PROVIDER=codex) ---------------------------------------------------
# docs/providers.md#chatgpt-subscription

# where `codex login` keeps auth.json; ~/.codex when unset
# CODEX_HOME=
# priority is faster and spends the plan quicker; the standard tier when unset
# CODEX_SERVICE_TIER=
# web search on the plan's allowance
# CODEX_WEB_SEARCH_ENABLED=true
# the codex cli version to claim; the newest known, installed or released when unset
# CODEX_CLIENT_VERSION=

# --- second provider -----------------------------------------------------------------------------
# docs/configuration.md#a-second-provider-behind-the-first

# answers while the first is out; every LLM_ setting again under LLM_FALLBACK_
# LLM_FALLBACK_PROVIDER=
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_API_KEY=

# --- character -----------------------------------------------------------------------------------
# docs/configuration.md#personality

# who the bot is; the built-in personality when unset
# PERSONALITY_FILE=
# the reference photo for pictures of itself; the bot's telegram avatar when unset
# SELF_IMAGE_FILE=
# what a portrait cannot show
# APPEARANCE_FILE=

# --- sandbox -------------------------------------------------------------------------------------
# docs/configuration.md#sandbox

# a regolith server's api, reachable from this container; off when unset
# REGOLITH_URL=
# the token that server starts with: openssl rand -hex 32
# REGOLITH_TOKEN=

# --- search --------------------------------------------------------------------------------------
# docs/configuration.md#web-search

# web and image search: either works alone
# TAVILY_API_KEY=
# SEARXNG_URL=

# --- gifs, memes and clips -----------------------------------------------------------------------
# docs/configuration.md#gifs-memes-and-clips

# GIPHY_API_KEY=
# memes and clips besides gifs; used when both keys are set
# KLIPY_API_KEY=

# --- youtube -------------------------------------------------------------------------------------
# docs/configuration.md#optional-tools

# a cookies.txt export for videos youtube will not serve without a sign-in
# YT_DLP_COOKIES_FILE=

# --- voice ---------------------------------------------------------------------------------------
# docs/configuration.md#voice-input

# transcribes voice messages and audio
# OPENAI_STT_API_KEY=
# OPENAI_STT_MODEL=gpt-transcribe

# voice replies and round video messages
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=VD1if7jDVYtAKs4P0FIY
# ELEVENLABS_TTS_MODEL=eleven_v4

# --- vision --------------------------------------------------------------------------------------
# docs/configuration.md#vision

# a model of its own for a chat model that cannot see; on the chat provider and key when only this
# VISION_MODEL=
# a provider of its own, read like the chat one under VISION_
# VISION_PROVIDER=
# VISION_API_KEY=
# VISION_BASE_URL=
# VISION_COMPATIBLE_API=completions
# the model's own when unset
# VISION_REASONING_EFFORT=
# the chat's when unset; read with VISION_PROVIDER only
# VISION_REQUEST_TIMEOUT_SECONDS=

# sticker replies learn sets through vision
# STICKERS_ENABLED=true

# --- images --------------------------------------------------------------------------------------
# docs/configuration.md#image-generation

# openai with OPENAI_IMAGE_API_KEY, or codex on the chatgpt plan with no key; off when unset
# IMAGE_PROVIDER=
# OPENAI_IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-2.5-flare
# low, medium, high or auto; xhigh and max on a gpt-image-2.5 model
# IMAGE_QUALITY=medium

# --- video ---------------------------------------------------------------------------------------
# docs/configuration.md#video-generation

# short videos with sound on xai's api; off when unset
# XAI_API_KEY=
# XAI_VIDEO_MODEL=grok-imagine-video-1.5
# 480p, 720p or 1080p; a video with references or the bot in it stops at 720p
# XAI_VIDEO_RESOLUTION=720p
# one of xai's preset voices for the bot; the model's own when unset
# XAI_VIDEO_VOICE=

# --- answering without a mention -----------------------------------------------------------------
# docs/configuration.md#answering-without-a-mention

# needs ADDRESSING_MODEL and the group log
# ADDRESSING_ENABLED=false
# never the chat model; on the chat provider and key when only this
# ADDRESSING_MODEL=
# spellings the chat uses for the bot; its handle without "bot" when unset
# ADDRESSING_NAMES=
# a provider of its own, read like the chat one under ADDRESSING_
# ADDRESSING_PROVIDER=
# ADDRESSING_API_KEY=
# ADDRESSING_BASE_URL=
# ADDRESSING_COMPATIBLE_API=completions
# the least the model takes when unset; a verdict waits five seconds at most
# ADDRESSING_REASONING_EFFORT=

# --- initiative ----------------------------------------------------------------------------------
# docs/configuration.md#initiative

# now and then says something unasked in a group; needs the group log
# INITIATIVE_ENABLED=true

# --- history -------------------------------------------------------------------------------------
# docs/configuration.md#conversation

# days a recapped exchange stays on disk
# CONVERSATION_RETENTION_DAYS=90
# the group transcript behind "what did i miss"
# GROUP_LOG_ENABLED=true
# GROUP_LOG_RETENTION_DAYS=30
# DB_FILE=data/db/vusan.db

# --- logging -------------------------------------------------------------------------------------
# docs/configuration.md#logging

# LOG_LEVEL=INFO
# DEBUG prints every request sent to the model, in full
# PROMPT_DUMP_LEVEL=OFF

# --- docker compose ------------------------------------------------------------------------------
# README.md#quick-start

# the bot's data directory; `mkdir -p data` before the first start, or docker makes it root's
# VUSAN_HOST_DIR=./data
# VUSAN_IMAGE=ghcr.io/helltar/vusan:latest

# the bot's environment: everything it reads, secrets included.
# copy to `.env`; see docs/configuration.md.
#
# compose reads this file twice — as the bot's own environment, and for the few values it substitutes
# into the bot's deployment, at the bottom. the sandbox server never sees it: it is configured by the
# `.env` beside its own compose file, whether it runs on this machine or on its own.

# --- required ------------------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=1234567890:qwerty
# the one person the bot belongs to: answered everywhere, never limited in a group
OWNER_ID=123456789
# who else the bot answers: user and chat ids. without it, the owner alone. the ban list wins over it.
# ALLOWED_IDS=123456789,-1001234567890
# BANNED_IDS=987654321

LLM_PROVIDER=openai
LLM_MODEL=gpt-6.1-sol
LLM_API_KEY=sk-proj-qwerty

# --- llm -----------------------------------------------------------------------------------------

# reasoning depth, none to max (low to max on anthropic); unset leaves the model's own default
# LLM_REASONING_EFFORT=high
# for LLM_PROVIDER=openai-compatible only: the address without /v1, and its api
# LLM_BASE_URL=http://localhost:8080
# LLM_COMPATIBLE_API=completions
# seconds one model call may hang before the bot gives up
# LLM_REQUEST_TIMEOUT_SECONDS=300
# the window of a model nobody states one for — an openai-compatible server whose model list says
# nothing of it runs on 16384 without this — or an override of the one stated
# LLM_CONTEXT_WINDOW_TOKENS=16384
# model calls one turn may make before it has to wrap up
# AGENT_MAX_MODEL_CALLS=100
# people served at the same time: match what the provider accepts at once
# MAX_CONCURRENT_TURNS=8

# run on a ChatGPT subscription instead: LLM_PROVIDER=codex, no LLM_API_KEY, sign in with `codex login`
# optional: the credentials live in ~/.codex unless this points somewhere else
# CODEX_HOME=/home/vusan/.codex
# priority buys faster replies, and spends the plan's allowance quicker
# CODEX_SERVICE_TIER=default
# a web search runs on the plan as well, from the same allowance; false turns it off
# CODEX_WEB_SEARCH_ENABLED=true
# pin the Codex CLI version to claim; by default the newest of the one installed here and the latest
# release on GitHub, so this is for a host that cannot reach GitHub
# CODEX_CLIENT_VERSION=0.162.0

# a second provider behind the first, for when the plan's window is spent or a key runs dry: the
# same settings again under LLM_FALLBACK_, any provider, codex included on one side of the pair
# LLM_FALLBACK_PROVIDER=openai-compatible
# LLM_FALLBACK_BASE_URL=https://api.deepseek.com
# LLM_FALLBACK_MODEL=deepseek-flash
# LLM_FALLBACK_API_KEY=sk-qwerty

# --- character -----------------------------------------------------------------------------------

# who the bot is; the built-in personality is used without it
# PERSONALITY_FILE=data/personality.md
# what it looks like in pictures of itself: the reference photo defaults to the bot's own Telegram
# avatar, the notes cover what a portrait cannot show
# SELF_IMAGE_FILE=data/avatar.png
# APPEARANCE_FILE=data/appearance.md

# --- sandbox -------------------------------------------------------------------------------------

# a shell with one persistent home per person across all chats — off without REGOLITH_URL, and a url
# without its token stops startup.
# the sandbox is a regolith server, deployed on its own: docs/sandbox.md. publishing pages to the
# web is that same server's doing, so it needs nothing here: docs/sites.md
# the address the server publishes its api on (REGOLITH_PUBLISH in its .env); its default,
# 127.0.0.1:8080, is out of reach from this container
# REGOLITH_URL=http://10.0.0.4:8080
# the same token that server is started with: 32 to 256 printable characters, openssl rand -hex 32
# REGOLITH_TOKEN=

# --- search and media ----------------------------------------------------------------------------

# web and image search: either provider works alone, and reading a page needs neither
# TAVILY_API_KEY=tvly-dev-qwerty
# SEARXNG_URL=http://searxng:8080
# GIPHY_API_KEY=qwerty
# finds memes and short clips besides GIFs, and is the one used when both keys are set
# KLIPY_API_KEY=qwerty
# YT_DLP_COOKIES_FILE=data/cookies/www.youtube.com_cookies.txt

# --- speech and vision ---------------------------------------------------------------------------

# voice messages and audio in
# OPENAI_STT_API_KEY=sk-proj-qwerty
# OPENAI_STT_MODEL=gpt-transcribe

# a vision model of its own, for a chat model that cannot see: on the chat provider with its key, or
# with VISION_PROVIDER a provider of its own, read like the chat one under VISION_
# VISION_MODEL=gpt-6-luna
# VISION_PROVIDER=openai
# VISION_API_KEY=sk-proj-qwerty
# for VISION_PROVIDER=openai-compatible only
# VISION_BASE_URL=https://api.deepseek.com
# VISION_COMPATIBLE_API=completions
# the model's own default when unset, never the chat's
# VISION_REASONING_EFFORT=low
# the chat's when unset; read with VISION_PROVIDER only
# VISION_REQUEST_TIMEOUT_SECONDS=120
# VISION_CONTEXT_WINDOW_TOKENS=400000
# sticker replies learn sets by describing them through vision; off keeps that spend at zero
# STICKERS_ENABLED=true

# --- answering without a mention -----------------------------------------------------------------

# answers a group message that calls the bot by name, or follows up on its answer, with no mention,
# reply or command. off unless switched on, and then it needs a model of its own and the group log
# ADDRESSING_ENABLED=true
# on the chat provider with its key, or with ADDRESSING_PROVIDER a provider of its own, read like the
# chat one under ADDRESSING_
# ADDRESSING_MODEL=gpt-6-luna
# spellings the chat uses besides the bot's telegram name; its handle without "bot" when unset
# ADDRESSING_NAMES=robin,robbie
# ADDRESSING_PROVIDER=openai
# ADDRESSING_API_KEY=sk-proj-qwerty
# for ADDRESSING_PROVIDER=openai-compatible only
# ADDRESSING_BASE_URL=https://api.deepseek.com
# ADDRESSING_COMPATIBLE_API=completions
# the least the model takes when unset: none where it takes it, asked at startup, otherwise the lowest
# its vendor lists, or low
# ADDRESSING_REASONING_EFFORT=none
# the chat's when unset; read with ADDRESSING_PROVIDER only
# ADDRESSING_REQUEST_TIMEOUT_SECONDS=30
# ADDRESSING_CONTEXT_WINDOW_TOKENS=400000

# --- a life of its own in groups -----------------------------------------------------------------

# writes itself an entry about each group's day after it ends, and remembers the last few. sends a
# day's transcript to the chat model with nobody having asked; needs the group log. false turns it off
# DIARY_ENABLED=true

# looks over a group people are writing in and now and then reacts or says something unasked. sends
# the chat's recent lines to the chat model; needs the group log. false turns it off
# INITIATIVE_ENABLED=true

# --- generated media -----------------------------------------------------------------------------

# image generation: openai renders through the OpenAI image API with IMAGE_API_KEY (the LLM key works
# there too); codex renders on the ChatGPT subscription signed in through CODEX_HOME, whatever the chat
# runs on, and needs no key. without a provider the drawing tools stay out
# IMAGE_PROVIDER=openai
# IMAGE_API_KEY=sk-proj-qwerty
# IMAGE_MODEL=gpt-image-2.5-flare
# quality: low, medium, high, auto; xhigh and max need a gpt-image-2.5 model
# IMAGE_QUALITY=medium

# voice replies and round video messages
# ELEVENLABS_API_KEY=sk_qwerty
# ELEVENLABS_VOICE_ID=VD1if7jDVYtAKs4P0FIY
# ELEVENLABS_TTS_MODEL=eleven_v4

# --- history and storage -------------------------------------------------------------------------

# DB_FILE=data/db/vusan.db
# days a recapped exchange stays on disk
# CONVERSATION_RETENTION_DAYS=90
# the group transcript behind "what did i miss"; false records nothing
# GROUP_LOG_ENABLED=true
# GROUP_LOG_RETENTION_DAYS=30

# --- logging -------------------------------------------------------------------------------------

# LOG_LEVEL=INFO
# DEBUG prints every request sent to the model, in full
# PROMPT_DUMP_LEVEL=OFF

# --- docker compose ------------------------------------------------------------------------------

# the bot's data directory, beside compose.yaml. create it before the first start — `mkdir -p data` —
# because a bind mount docker creates comes out owned by root, and the bot runs as uid 1000.
# VUSAN_HOST_DIR=./data

# VUSAN_IMAGE=ghcr.io/helltar/vusan:latest

# see docs/configuration.md

# telegram
TELEGRAM_BOT_TOKEN=1234567890:qwerty
ALLOWED_IDS=123456789,-1001234567890
# BANNED_IDS=987654321

# llm
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_API_KEY=sk-proj-qwerty
# LLM_BASE_URL=http://localhost:8080
# run on a ChatGPT subscription instead: LLM_PROVIDER=codex, no LLM_API_KEY, sign in with `codex login`
# use a dedicated directory whose config.toml sets cli_auth_credentials_store="file"
# CODEX_HOME=/home/vusan/.codex-vusan
# LLM_OPENAI_ENDPOINT=completions
# LLM_REASONING_EFFORT=medium
# LLM_REQUEST_TIMEOUT_SECONDS=120
# LLM_CONTEXT_WINDOW_TOKENS=16384
# LLM_DAILY_TOKEN_BUDGET=2500000
# LLM_TOKEN_BUDGET_TIMEZONE=UTC
# LLM_TOKEN_BUDGET_FAIR_SHARE_AT_PERCENT=70

# personality
# PERSONALITY=You are Ada — a laconic assistant with dry humor. Reply in the user's language.
# PERSONALITY_FILE=data/personality.md

# appearance — what it looks like in pictures of itself; the reference photo
# defaults to the bot's own Telegram avatar
# SELF_IMAGE_FILE=data/avatar.png
# APPEARANCE=Tall, short bleached hair, oversized band t-shirts.
# APPEARANCE_FILE=data/appearance.md

# code execution
SANDBOX_URL=http://vusan-sandbox:8080
# SANDBOX_TIMEOUT_SECONDS=120
# SANDBOX_POOL_SIZE=2

# web and media lookup
# TAVILY_API_KEY=tvly-dev-qwerty
# SEARXNG_URL=http://searxng:8080
# GIPHY_API_KEY=qwerty
# YT_DLP_COOKIES_FILE=data/cookies/www.youtube.com_cookies.txt

# speech and vision
# OPENAI_STT_API_KEY=sk-proj-qwerty
# OPENAI_STT_MODEL=gpt-4o-transcribe
# OPENAI_STT_MAX_DURATION_SECONDS=300

# OPENAI_VISION_API_KEY=sk-proj-qwerty
# OPENAI_VISION_MODEL=gpt-5.4-mini

# generated media
# image generation: optional on LLM_PROVIDER=codex, which renders on the subscription instead
# OPENAI_IMAGE_API_KEY=sk-proj-qwerty
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_IMAGE_QUALITY=medium

# ELEVENLABS_API_KEY=sk_qwerty
# ELEVENLABS_VOICE_ID=VD1if7jDVYtAKs4P0FIY
# ELEVENLABS_TTS_MODEL=eleven_v3

# agent loop
# AGENT_MAX_ITERATIONS=70

# storage, memory, and tasks
# DB_FILE=data/db/vusan.db
# CONVERSATION_MAX_RECENT_INTERACTIONS=24
# CONVERSATION_MAX_STORED_INTERACTIONS=100
# CONVERSATION_RETENTION_DAYS=90
# GROUP_LOG_ENABLED=true
# GROUP_LOG_RETENTION_DAYS=30
# GROUP_LOG_MAX_MESSAGES_PER_CHAT=20000
# GROUP_LOG_RECENT_MESSAGES=15
# GROUP_LOG_RECENT_MINUTES=60
# MAX_MEMORY_PER_SCOPE=10
# MAX_TASKS_PER_USER=5
# MAX_FOLLOW_UPS_PER_USER=3
# TASK_MAX_LATENESS_MINUTES=60
